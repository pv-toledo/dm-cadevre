// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  @@map("student_status")
}

model Student {
  id String @id @default(uuid()) @db.Uuid
  name String 
  birthDate DateTime @db.Date @map("birth_date")
  studentPhoneNumber String? @map("student_phone_number")
  responsibleName String? @map("responsible_name")
  responsiblePhoneNumber String? @map("responsible_phone_number")
  church String
  address String
  photoPath String? @map("photo_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status StudentStatus @default(ACTIVE)
  email String?

  enrollments Enrollment[]

  @@map("students")
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  @@map("course_status")
}

model Course {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status CourseStatus @default(ACTIVE)

  classPlans ClassPlan[]
  enrollments Enrollment[]
  instruments Instrument[]

  @@map("courses")
}

enum ModalityType {
  INDIVIDUAL
  GROUP
  @@map("modality_types")
}

model Modality {
  type ModalityType @id
  priceCents Int @map("price_cents")
  updatedAt DateTime @updatedAt @map("updated_at")

  classPlans ClassPlan[]

  @@map("modalities")
}

model ClassPlan {
  id String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid @map("course_id")
  modalityType ModalityType @map("modality_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])
  modality Modality @relation(fields: [modalityType], references: [type])
  @@unique([courseId, modalityType])

  enrollments Enrollment[]

  @@map("class_plans")
}

enum EnrollmentStatus {
  ACTIVE
  LOCKED
  ENDED
  @@map("enrollment_status")
}

model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  classPlanId String @map("class_plan_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  status EnrollmentStatus @default(ACTIVE)
  startedAt DateTime @default(now()) @map("started_at")
  lockedAt DateTime? @map("locked_at")
  endedAt DateTime? @map("ended_at")

  student Student @relation(fields: [studentId], references: [id])
  classPlan ClassPlan @relation(fields: [classPlanId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@map("enrollments")
}

  enum InstrumentStatus {
    AVAILABLE
    LOANED
    MAINTENANCE
    RETIRED

    @@map("instrument_status")
  }

  enum InstrumentCondition {
    PERFECT
    DEFECTIVE

    @@map("instrument_condition")
  }

  model Instrument {
    id String @id @default(uuid()) @db.Uuid
    name String
    courseId String @db.Uuid @map("course_id")
    tag String @unique
    brand String
    model String?
    serialNumber String? @map("serial_number")
    condition InstrumentCondition @default(PERFECT)
    conditionDescription String? @map("condition_description")
    status InstrumentStatus @default(AVAILABLE)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    course Course @relation(fields: [courseId], references: [id])

    @@map("instruments")
  }