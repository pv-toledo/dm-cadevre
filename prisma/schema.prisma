// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  @@map("student_status")
}

model Student {
  id String @id @default(uuid()) @db.Uuid
  name String 
  birthDate DateTime @db.Date @map("birth_date")
  studentPhoneNumber String? @map("student_phone_number")
  responsibleName String? @map("responsible_name")
  responsiblePhoneNumber String? @map("responsible_phone_number")
  church String
  address String
  photoPath String? @map("photo_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status StudentStatus @default(ACTIVE)
  email String?

  @@map("students")
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  @@map("course_status")
}

model Course {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status CourseStatus @default(ACTIVE)

  classPlans ClassPlan[]

  @@map("courses")
}

enum ModalityType {
  INDIVIDUAL
  GROUP
  @@map("modality_types")
}

model Modality {
  type ModalityType @id
  priceCents Int @map("price_cents")
  updatedAt DateTime @updatedAt @map("updated_at")

  classPlans ClassPlan[]

  @@map("modalities")
}

model ClassPlan {
  id String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid @map("course_id")
  modalityType ModalityType @map("modality_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])
  modality Modality @relation(fields: [modalityType], references: [type])
  @@unique([courseId, modalityType])

  @@map("class_plans")
}
