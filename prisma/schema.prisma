// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  @@map("student_status")
}

model Student {
  id String @id @default(uuid()) @db.Uuid
  name String 
  birthDate DateTime @db.Date @map("birth_date")
  studentPhoneNumber String? @map("student_phone_number")
  responsibleName String? @map("responsible_name")
  responsiblePhoneNumber String? @map("responsible_phone_number")
  church String
  address String
  photoPath String? @map("photo_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status StudentStatus @default(ACTIVE)
  email String?

  enrollments Enrollment[]
  userProfiles UserProfile[]

  @@map("students")
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  @@map("course_status")
}

model Course {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status CourseStatus @default(ACTIVE)

  classPlans ClassPlan[]
  enrollments Enrollment[]
  instruments Instrument[]

  @@map("courses")
}

enum ModalityType {
  INDIVIDUAL
  GROUP
  @@map("modality_types")
}

model Modality {
  type ModalityType @id
  priceCents Int @map("price_cents")
  updatedAt DateTime @updatedAt @map("updated_at")

  classPlans ClassPlan[]

  @@map("modalities")
}

model ClassPlan {
  id String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid @map("course_id")
  modalityType ModalityType @map("modality_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])
  modality Modality @relation(fields: [modalityType], references: [type])
  @@unique([courseId, modalityType])

  enrollments Enrollment[]

  @@map("class_plans")
}

enum EnrollmentStatus {
  ACTIVE
  LOCKED
  ENDED
  @@map("enrollment_status")
}

model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  classPlanId String @map("class_plan_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  status EnrollmentStatus @default(ACTIVE)
  startedAt DateTime @default(now()) @map("started_at")
  lockedAt DateTime? @map("locked_at")
  endedAt DateTime? @map("ended_at")

  student Student @relation(fields: [studentId], references: [id])
  classPlan ClassPlan @relation(fields: [classPlanId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  loans Loan[]
  tuitionPayments TuitionPayment[]
  maintenanceFees MaintenanceFee[]

  @@map("enrollments")
}

  enum InstrumentStatus {
    AVAILABLE
    LOANED
    MAINTENANCE
    RETIRED

    @@map("instrument_status")
  }

  enum InstrumentCondition {
    PERFECT
    DEFECTIVE

    @@map("instrument_condition")
  }

  model Instrument {
    id String @id @default(uuid()) @db.Uuid
    name String
    courseId String @db.Uuid @map("course_id")
    tag String @unique
    brand String
    model String?
    serialNumber String? @map("serial_number")
    condition InstrumentCondition @default(PERFECT)
    conditionDescription String? @map("condition_description")
    status InstrumentStatus @default(AVAILABLE)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    course Course @relation(fields: [courseId], references: [id])
    loans Loan[]

    @@map("instruments")
  }

  model Loan {
    id String @id @default(uuid()) @db.Uuid
    instrumentId String @map("instrument_id") @db.Uuid
    enrollmentId String @map("enrollment_id") @db.Uuid
    loanCondition InstrumentCondition @map("loan_condition")
    loanConditionDescription String? @map("loan_condition_description")
    loanedAt DateTime @default(now()) @map("loaned_at")
    returnedAt DateTime? @map("returned_at")
    returnCondition InstrumentCondition? @map("return_condition")
    returnConditionDescription String? @map("return_condition_description")

    instrument Instrument @relation(fields: [instrumentId], references: [id])
    enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

    @@map("loans")
  }

  enum PaymentMethod {
    CASH
    PIX

    @@map("payment_methods")
  }

  model TuitionPayment {
    id String @id @default(uuid()) @db.Uuid
    enrollmentId String @db.Uuid @map("enrollment_id")
    referenceMonth DateTime @db.Date @map("reference_month")
    amountCents Int @map("amount_cents")
    method PaymentMethod?
    dueDate DateTime @db.Date @map("due_date")
    paidAt DateTime? @db.Date @map("paid_at")
    confirmedByUserId String? @db.Uuid @map("confirmed_by_user_id")
    confirmedAt DateTime? @db.Date @map("confirmed_at") 

    @@unique([enrollmentId, referenceMonth])

    enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
    userProfile UserProfile? @relation(fields: [confirmedByUserId], references: [id])

    @@map("tuition_payments")
  }

  model MaintenanceFee {
    id String @id @default(uuid()) @db.Uuid
    enrollmentId String @db.Uuid @map("enrollment_id")
    referenceYear DateTime @db.Date @map("reference_year")
    amountCents Int @map("amount_cents")
    dueDate DateTime @db.Date @map("due_date")

    @@unique([enrollmentId, referenceYear])

    enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
    maintenanceFeePayments MaintenanceFeePayment[]

    @@map("maintenance_fees")
  }

  model MaintenanceFeePayment {
    id String @id @default(uuid()) @db.Uuid
    maintenanceFeeId String @db.Uuid @map("maintenance_fee_id")
    amountCents Int @map("amount_cents")
    paidAt DateTime @db.Date @map("paid_at")
    method PaymentMethod
    confirmedByUserId String @db.Uuid @map("confirmed_by_user_id")

    maintenanceFee MaintenanceFee @relation(fields: [maintenanceFeeId], references: [id])
    userProfile UserProfile @relation(fields: [confirmedByUserId], references: [id])

    @@map("maintenance_fee_payments")
  }

  enum UserRole {
    ADMIN
    STAFF
    STUDENT

    @@map("user_roles")
  }

  model UserProfile {
    id String @id @db.Uuid
    name String
    role UserRole
    studentId String? @db.Uuid @map("student_id")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    student Student? @relation(fields: [studentId], references: [id])

    logs AuditLog[]
    tuitionPaymentsConfirmed TuitionPayment[]
    maintenanceFeePaymentsConfirmed MaintenanceFeePayment[]

    @@map("user_profiles")
  }

  enum EntityType {
    STUDENT
    COURSE
    ENROLLMENT
    CLASS_PLAN
    MODALITY
    INSTRUMENT
    LOAN
    MAINTENANCE_FEE
    TUITION_PAYMENT
    MAINTENANCE_FEE_PAYMENT
    USER_PROFILE

    @@map("entity_types")
  }

  model AuditLog {
    id String @id @default(uuid()) @db.Uuid
    actorId String @db.Uuid @map("actor_id")
    action String
    entityType EntityType @map("entity_type")
    entityId String @db.Uuid @map("entity_id")
    payload Json @db.JsonB
    createdAt DateTime @default(now()) @map("created_at")

    userProfile UserProfile @relation(fields: [actorId], references: [id])

    @@map("audit_logs")
  }